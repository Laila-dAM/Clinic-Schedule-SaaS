generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  patients     Patient[]
  users        User[]
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("owner")
  clinicId  String
  createdAt DateTime @default(now())
  roleId    String?
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  roleRef   Role?    @relation(fields: [roleId], references: [id])
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String?
  clinicId     String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
}

model Appointment {
  id        String   @id @default(uuid())
  date      DateTime
  time      String
  service   String
  status    String   @default("scheduled")
  clinicId  String
  patientId String
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])

  @@unique([clinicId, date, time])
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}
